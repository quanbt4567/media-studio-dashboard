# Required for the /api/generate route
GEMINI_API_KEY=your_gemini_api_key_here
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Required for login (see README "Authentication")
# Random string, min 16 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_secret_here
# JSON array of users, one line. Use plain "password" for simplicity,
# or "passwordHash" (bcrypt, via: npm run hash-password "pw") for better hygiene.
AUTH_USERS='[{"username":"admin","role":"admin","password":"admin123"},{"username":"designer","role":"media","password":"designer123"},{"username":"writer","role":"content","password":"writer123"}]'

# Optional: enables the /api/publish-due auto-publish endpoint for external schedulers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then schedule: */15 * * * * curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-app/api/publish-due
CRON_SECRET=

# Optional: branding — drop your logo image at public/club-logo.png (square PNG/JPG)
# and restart the dev server. Optionally override the name/tagline shown next to
# the logo (requires rebuild after changing).
# NEXT_PUBLIC_CLUB_NAME=My Club
# NEXT_PUBLIC_CLUB_TAGLINE=media desk

# Optional: AI cover-art generation via xKiro (sensenova-u1.5-lite, free tier).
# Get a key at https://xkiro.com console (API Keys page) — put it here,
# or paste it in the admin Settings tab (no redeploy needed).
XKIRO_API_KEY=

# Optional: persistent storage. Priority: Supabase > Vercel KV > local files.
# Recommended: Supabase — create a project at https://supabase.com, then in
# the SQL Editor run:
#   create table if not exists msd_store (
#     key text primary key,
#     value jsonb not null,
#     updated_at timestamptz default now()
#   );
#   alter table msd_store enable row level security;
# Then copy Project URL + service_role key (Project Settings → API).
# WARNING: service_role bypasses RLS — keep it secret, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy option: Vercel KV (Vercel Dashboard → Storage → Create Database → KV).
# Only used when the Supabase vars above are NOT set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
