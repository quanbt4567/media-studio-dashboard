# Required for the /api/generate route
GEMINI_API_KEY=your_gemini_api_key_here
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Required for login (see README "Authentication")
# Random string, min 16 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_secret_here
# JSON array of users, one line. Use plain "password" for simplicity,
# or "passwordHash" (bcrypt, via: npm run hash-password "pw") for better hygiene.
AUTH_USERS='[{"username":"admin","role":"admin","password":"admin123"},{"username":"designer","role":"media","password":"designer123"},{"username":"writer","role":"content","password":"writer123"}]'
